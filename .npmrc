# pnpm configuration for NovaCP monorepo

# Hoist next-auth and its dependencies to fix pnpm TS2742 "cannot be named" type errors.
# This is a known issue with next-auth beta and pnpm's strict node_modules isolation.
public-hoist-pattern[]=*@auth*
public-hoist-pattern[]=next-auth

# Hoist eslint and its plugins for the shared config package
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
