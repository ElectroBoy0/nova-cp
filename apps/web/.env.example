# =============================================================
# NovaCP Web — Production Environment Variables (Vercel)
# =============================================================

# -------------------------------------------------------------
# 1. Server-Only Secrets (Never exposed to browser)
# -------------------------------------------------------------

# NextAuth / Auth.js encryption secret (generate with `openssl rand -hex 32`)
AUTH_SECRET="change_this_to_a_random_32_byte_secure_secret"

# Trust Vercel's reverse proxy host headers (Required on Vercel)
AUTH_TRUST_HOST="true"

# Google OAuth Credentials (from Google Cloud Console)
# Authorized Redirect URI: https://<your-vercel-domain>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_oauth_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"

# GitHub OAuth Credentials (Optional - from GitHub Developer Settings)
# Authorized Callback URL: https://<your-vercel-domain>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID="your_github_oauth_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_client_secret"

# Backend FastAPI URL on Railway (used by server routes & BFF proxy)
API_URL="https://your-railway-app.up.railway.app"

# Shared internal API secret between Next.js BFF and FastAPI
# MUST match INTERNAL_API_KEY set on Railway backend
INTERNAL_API_KEY="your_shared_internal_api_key"

# -------------------------------------------------------------
# 2. Client-Accessible Public Variables (Prefixed with NEXT_PUBLIC_)
# -------------------------------------------------------------

# Canonical URL of the production web application
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
