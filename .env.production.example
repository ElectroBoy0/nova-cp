# =============================================================
# NovaCP Production Environment Variable Template (.env.production)
# Copy this file to .env.production on your production server
# =============================================================

# ---- Application & URLs ----
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com
API_URL=http://api:8000
SECRET_KEY=change_this_to_a_random_32_byte_secure_string_in_production

# ---- NextAuth / Authentication ----
AUTH_SECRET=change_this_to_a_random_64_character_hex_string
AUTH_URL=https://your-domain.com/api/auth
AUTH_TRUST_HOST=true

# OAuth Providers (GitHub & Google)
AUTH_GITHUB_ID=your_production_github_oauth_client_id
AUTH_GITHUB_SECRET=your_production_github_oauth_client_secret
AUTH_GOOGLE_ID=your_production_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_production_google_oauth_client_secret

# ---- Database (PostgreSQL) ----
POSTGRES_USER=novacp_prod
POSTGRES_PASSWORD=generate_strong_db_password_here
POSTGRES_DB=novacp_production
POSTGRES_PORT=5432

# ---- Cache (Redis) ----
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_PORT=6379

# ---- LLM / Gemini API (Socratic Hints & AI Recommendations) ----
GEMINI_API_KEY=your_production_gemini_api_key

# ---- Security & Execution ----
SANDBOX_EXECUTION_TIMEOUT_SEC=5
SANDBOX_MEMORY_LIMIT_MB=256
MAX_CODE_RUNS_PER_MINUTE=20
