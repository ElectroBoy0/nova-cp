# ==============================================
# NovaCP — Environment Configuration Template
# ==============================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values below
# 3. NEVER commit .env to git — it is in .gitignore
# ==============================================

# -----------------------------------------------
# Application
# -----------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------
# Auth.js v5 (NextAuth)
# Generate AUTH_SECRET: openssl rand -base64 32
# -----------------------------------------------
AUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_oauth_app_client_id
AUTH_GITHUB_SECRET=your_github_oauth_app_client_secret

# Google OAuth App
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# -----------------------------------------------
# PostgreSQL
# -----------------------------------------------
POSTGRES_USER=novacp
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=novacp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async URL for FastAPI/SQLAlchemy
DATABASE_URL=postgresql+asyncpg://novacp:CHANGE_ME_IN_PRODUCTION@localhost:5432/novacp

# -----------------------------------------------
# Redis
# -----------------------------------------------
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION@localhost:6379/0

# -----------------------------------------------
# FastAPI Backend
# -----------------------------------------------
# Generate: openssl rand -hex 32
API_SECRET_KEY=GENERATE_WITH_openssl_rand_-hex_32
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------
# Internal Service Auth (Next.js → FastAPI)
# This key is sent in the X-Internal-API-Key header
# Generate: openssl rand -hex 32
# -----------------------------------------------
INTERNAL_API_KEY=GENERATE_WITH_openssl_rand_-hex_32
NEXT_PUBLIC_INTERNAL_API_KEY=  # Leave empty — not exposed to client

# -----------------------------------------------
# Codeforces API (M1 — not required for M0)
# -----------------------------------------------
# CF_API_KEY=
# CF_API_SECRET=

# -----------------------------------------------
# Google Gemini API
# Get one at https://aistudio.google.com/
# -----------------------------------------------
# GEMINI_API_KEY=
